# 统一换行符，避免跨平台检出时出现整文件差异
* text=auto eol=crlf

# 脚本与配置固定用 CRLF（Windows 专用工具链）
*.ps1 text eol=crlf
*.iss text eol=crlf
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.md text eol=lf

# 二进制文件不要做换行转换
*.png binary
*.ico binary
*.exe binary
*.zip binary
