<!--
  图标控件外观。
  所有几何以 16×16 视口绘制；描边为默认风格，填充型通过 Style="{StaticResource Icon.Filled}" 切换。
  颜色转发自控件的 Foreground，因此主题切换（DynamicResource）自动生效。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:DeskTools.App.Controls">

  <!-- 默认（隐式）样式：描边型，颜色取次要文字色 -->
  <Style TargetType="ctl:Icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Icon}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Icon">
          <Path Data="{TemplateBinding Geometry}"
                Stretch="Uniform"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1.3"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 显式键：便于在需要时以 BasedOn 复用 -->
  <Style x:Key="Icon.Base" TargetType="ctl:Icon" BasedOn="{StaticResource {x:Type ctl:Icon}}" />

  <!-- 填充型：用于文件夹等实心图标 -->
  <Style x:Key="Icon.Filled" TargetType="ctl:Icon" BasedOn="{StaticResource Icon.Base}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Icon">
          <Path Data="{TemplateBinding Geometry}"
                Stretch="Uniform"
                Fill="{TemplateBinding Foreground}"
                Stroke="{x:Null}"
                SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 语义色变体 -->
  <Style x:Key="Icon.Accent" TargetType="ctl:Icon" BasedOn="{StaticResource Icon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <Style x:Key="Icon.Muted" TargetType="ctl:Icon" BasedOn="{StaticResource Icon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>

  <Style x:Key="Icon.Inverse" TargetType="ctl:Icon" BasedOn="{StaticResource Icon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
  </Style>

</ResourceDictionary>
