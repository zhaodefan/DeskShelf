<Application x:Class="DeskTools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DeskTools.App.Converters"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 主题令牌：浅色 / 深色同名键，运行期整体替换（必须是第 0 项） -->
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <!-- 图标外观 -->
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <!-- 控件样式 -->
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <!-- unit 卡片模板（按 UnitCatalog.ViewKey 分派） -->
        <ResourceDictionary Source="Templates/UnitTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BooleanToVisibilityConverter x:Key="Converter.BoolToVisibility" />
      <conv:BooleanToVisibilityConverter x:Key="Converter.BoolToVisibility.Invert" Invert="True" />
      <conv:NotNullToVisibilityConverter x:Key="Converter.NotNullToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
