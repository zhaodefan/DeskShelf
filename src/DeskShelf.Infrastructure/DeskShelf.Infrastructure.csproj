<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeskShelf.Infrastructure</RootNamespace>
    <AssemblyName>DeskShelf.Infrastructure</AssemblyName>
    <!-- 需要 WPF 的剪贴板/图像解码 API，但只作为「系统适配层」实现 Application 的接口 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskShelf.Application\DeskShelf.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
