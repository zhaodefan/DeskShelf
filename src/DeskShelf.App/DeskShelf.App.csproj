<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeskShelf.App</RootNamespace>
    <AssemblyName>DeskShelf</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deskshelf.ico</ApplicationIcon>
    <!-- 表现层是唯一允许接触 System.Windows 的工程 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskShelf.Application\DeskShelf.Application.csproj" />
    <ProjectReference Include="..\DeskShelf.Infrastructure\DeskShelf.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让测试工程可以覆盖表现层的 internal 辅助类（如单实例唤醒通道） -->
    <InternalsVisibleTo Include="DeskShelf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标同时作为嵌入式资源（常规构建下托盘图标走 pack URI 读取），
         并在发布时复制到输出目录：单文件发布后 pack URI 可能解析失败，
         而 H.NotifyIcon 要求 ImageSource 带 UriSource，此时只能从文件加载。 -->
    <EmbeddedResource Include="Assets\deskshelf.ico" LogicalName="DeskShelf.Assets.deskshelf.ico" />
    <None Include="Assets\deskshelf.ico" Link="deskshelf.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    单文件发布会过滤掉 None 内容项，这里显式把托盘图标放到发布目录。
    托盘图标必须是「带 UriSource 的位图」，而单文件内的资源无法提供 UriSource，
    因此发布包必须同时带一份 deskshelf.ico。
  -->
  <Target Name="CopyTrayIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="Assets\deskshelf.ico"
          DestinationFiles="$(PublishDir)deskshelf.ico"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
