<Window x:Class="DeskShelf.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DeskShelf.App.Controls"
        xmlns:behaviors="clr-namespace:DeskShelf.App.Behaviors"
        xmlns:vm="clr-namespace:DeskShelf.App.ViewModels"
        Title="桌面置物架 设置"
        Width="400"
        Height="520"
        MinWidth="360"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <Border Background="{DynamicResource Brush.Window.Background}"
          BorderBrush="{DynamicResource Brush.Border.Strong}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Window}"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--#region 顶栏（可拖拽移动） -->
      <Border Grid.Row="0"
              Height="{DynamicResource Size.Toolbar.Height}"
              Background="Transparent"
              behaviors:WindowDragBehavior.IsEnabled="True">
        <Grid Margin="12,0,8,0">
          <TextBlock Style="{StaticResource Text.Toolbar.Title}"
                     Text="设置"
                     VerticalAlignment="Center" />
          <Button Style="{StaticResource IconButton}"
                  AutomationProperties.Name="关闭设置窗口"
                  HorizontalAlignment="Right"
                  Click="OnCloseClick"
                  ToolTip="关闭（Esc）">
            <ctl:Icon Geometry="{StaticResource Icon.Close}" Size="14" />
          </Button>
        </Grid>
      </Border>
      <!--#endregion -->

      <!--#region 设置内容 -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="12,2,10,4"
                    Focusable="False">
        <StackPanel>

          <!-- 快捷键 -->
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.GroupTitle}" Text="呼出快捷键" />
              <StackPanel Orientation="Horizontal">
                <ctl:HotkeyBox x:Name="HotkeyInput"
                               Gesture="{Binding Hotkey, Mode=OneWay}"
                               GestureCaptured="OnHotkeyCaptured" />
                <Button Style="{StaticResource Button.Secondary}"
                        AutomationProperties.Name="重置快捷键为 Alt+X"
                        Content="重置为 Alt+X"
                        Margin="8,0,0,0"
                        Click="OnResetHotkeyClick" />
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Hint}"
                         Text="点击上面的方框后直接按下组合键即可（至少含一个修饰键）；Esc 放弃录入，Backspace 清空。" />
              <TextBlock x:Name="HotkeyWarning"
                         Style="{StaticResource Text.Hint}"
                         Text="{Binding StatusMessage}"
                         Foreground="{DynamicResource Brush.Danger}"
                         Visibility="{Binding IsHotkeyConflict, Converter={StaticResource Converter.BoolToVisibility}}" />
            </StackPanel>
          </Border>

          <!-- 外观 -->
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.GroupTitle}" Text="外观" />
              <ItemsControl ItemsSource="{Binding ThemeOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource Radio.Row}"
                                 Content="{Binding Label}"
                                 GroupName="Theme"
                                 Tag="{Binding Value}"
                                 Click="OnThemeOptionClick" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox x:Name="ThumbnailToggle"
                        Style="{StaticResource Check.Toggle}"
                        Content="在面板中显示图片缩略图"
                        Margin="0,8,0,0"
                        Checked="OnThumbnailToggled"
                        Unchecked="OnThumbnailToggled" />
              <TextBlock Style="{StaticResource Text.Hint}"
                         Text="关闭缩略图后，图片 unit 只显示尺寸与格式信息，适合配置较低的机器。" />
            </StackPanel>
          </Border>

          <!-- 启动 -->
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.GroupTitle}" Text="启动" />
              <CheckBox x:Name="AutoStartToggle"
                        Style="{StaticResource Check.Toggle}"
                        Content="开机自动启动（登录后自动运行）"
                        Checked="OnAutoStartToggled"
                        Unchecked="OnAutoStartToggled" />
              <TextBlock Style="{StaticResource Text.Hint}"
                         Text="写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run，不需要管理员权限。" />
            </StackPanel>
          </Border>

          <!-- 存储 -->
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.GroupTitle}" Text="存储" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Body}"
                           Text="unit 数量上限"
                           VerticalAlignment="Center" />
                <TextBox x:Name="MaxUnitsBox"
                         Style="{StaticResource NumberBox}"
                         Margin="8,0,0,0"
                         PreviewTextInput="OnMaxUnitsPreviewTextInput"
                         LostFocus="OnMaxUnitsLostFocus" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="（20 ~ 10000）"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Style="{StaticResource Text.Caption}"
                         Text="{Binding UnitCountText}"
                         Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource Button.Secondary}"
                        AutomationProperties.Name="打开数据目录"
                        Content="打开数据目录"
                        Click="OnOpenDataFolderClick" />
                <Button Style="{StaticResource Button.Secondary}"
                        AutomationProperties.Name="清空面板内容"
                        Content="清空面板内容"
                        Margin="8,0,0,0"
                        Click="OnClearShelfClick" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 关于 -->
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.GroupTitle}" Text="关于" />
              <TextBlock Style="{StaticResource Text.Hint}"
                         Text="桌面置物架 DeskShelf · 退出请右键任务栏通知区域的图标选择「退出桌面置物架」。" />
              <TextBlock Style="{StaticResource Text.Hint}"
                         Text="数据与日志位于 %APPDATA%\DeskShelf。" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
      <!--#endregion -->

      <!--#region 底栏操作 -->
      <Border Grid.Row="2"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Divider}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,6,6"
              Padding="12,10">
        <Grid>
          <TextBlock x:Name="StatusLabel"
                     Style="{StaticResource Text.Caption}"
                     Text="{Binding StatusMessage}"
                     VerticalAlignment="Center"
                     MaxWidth="220"
                     HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Secondary}"
                    AutomationProperties.Name="取消并回滚设置"
                    Content="取消"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource Button.Primary}"
                    AutomationProperties.Name="保存设置"
                    Content="保存"
                    Margin="8,0,0,0"
                    Click="OnSaveClick" />
          </StackPanel>
        </Grid>
      </Border>
      <!--#endregion -->
    </Grid>
  </Border>
</Window>
