<Window x:Class="DeskShelf.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DeskShelf.App.Controls"
        xmlns:behaviors="clr-namespace:DeskShelf.App.Behaviors"
        xmlns:vm="clr-namespace:DeskShelf.App.ViewModels"
        Title="桌面置物架"
        Width="360"
        Height="480"
        MinWidth="260"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource Font.Size.Body}"
        d:DataContext="{d:DesignInstance Type=vm:PanelViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <Window.Resources>
    <!-- 全局消息条动画 -->
    <Storyboard x:Key="Storyboard.StatusIn">
      <DoubleAnimation Storyboard.TargetName="StatusBar"
                       Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.12" />
    </Storyboard>
  </Window.Resources>

  <Border x:Name="WindowRoot"
          Background="{DynamicResource Brush.Window.Background}"
          BorderBrush="{DynamicResource Brush.Border.Strong}"
          BorderThickness="1"
          CornerRadius="{DynamicResource Radius.Window}"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <!-- 操作条（新建文本 unit） -->
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--#region 顶栏：左侧为标题+拖拽区，右侧为 设置 / 最小化 -->
      <Border x:Name="TitleBar"
              Grid.Row="0"
              Height="{DynamicResource Size.Toolbar.Height}"
              Background="Transparent"
              behaviors:WindowDragBehavior.IsEnabled="True">
        <Grid Margin="{DynamicResource Space.Toolbar}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <ctl:Icon Geometry="{StaticResource Icon.Logo}"
                      Size="15"
                      Foreground="{DynamicResource Brush.Accent}"
                      Margin="0,0,7,0" />
            <!-- 中文正式名 + 英文项目名（英文名用小字弱化，避免抢主标题） -->
            <TextBlock Style="{StaticResource Text.Toolbar.Title}" Text="桌面置物架" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Text="DeskShelf"
                       Margin="6,1,0,0"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CountLabel"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding CountText}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 撤销 -->
            <Button Style="{StaticResource IconButton}"
                    AutomationProperties.Name="撤销上一步删除"
                    Command="{Binding UndoCommand}"
                    IsEnabled="{Binding CanUndo}"
                    ToolTip="撤销上一步删除（Ctrl+Z）">
              <ctl:Icon Geometry="{StaticResource Icon.Undo}" Size="14" />
            </Button>

            <!-- 清空 -->
            <Button Style="{StaticResource IconButton}"
                    AutomationProperties.Name="清空面板"
                    Command="{Binding ClearAllCommand}"
                    ToolTip="清空面板">
              <ctl:Icon Geometry="{StaticResource Icon.Clear}" Size="14" />
            </Button>

            <Border Width="1"
                    Height="16"
                    Background="{DynamicResource Brush.Divider}"
                    Margin="4,0" />

            <!-- 设置 -->
            <Button x:Name="SettingsButton"
                    Style="{StaticResource IconButton}"
                    AutomationProperties.Name="设置"
                    Click="OnSettingsClick"
                    ToolTip="设置">
              <ctl:Icon Geometry="{StaticResource Icon.Settings}" Size="14" />
            </Button>

            <!-- 最小化：收起面板（保留托盘图标常驻） -->
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource IconButton}"
                    AutomationProperties.Name="最小化面板"
                    Click="OnMinimizeClick"
                    ToolTip="最小化（保留托盘图标）">
              <ctl:Icon Geometry="{StaticResource Icon.Minimize}" Size="14" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!--#endregion -->

      <!--#region 操作条：新建文本 unit（位于标题栏下方） -->
      <Border Grid.Row="1"
              Height="30"
              Background="Transparent"
              BorderBrush="{DynamicResource Brush.Divider}"
              BorderThickness="0,0,0,1">
        <Button x:Name="AddTextUnitButton"
                AutomationProperties.Name="新建文本 unit"
                Command="{Binding AddTextUnitCommand}"
                HorizontalAlignment="Left"
                Margin="8,0,0,0"
                Cursor="Hand"
                ToolTip="新建一个空的文本 unit，随后可直接输入">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root"
                      Background="Transparent"
                      CornerRadius="{DynamicResource Radius.Button}"
                      Padding="7,3">
                <StackPanel Orientation="Horizontal">
                  <ctl:Icon x:Name="Glyph"
                            Geometry="{StaticResource Icon.TextAdd}"
                            Size="14"
                            Foreground="{DynamicResource Brush.Accent}"
                            VerticalAlignment="Center" />
                  <TextBlock Text="新建文本"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             FontFamily="{DynamicResource Font.Ui}"
                             FontSize="{DynamicResource Font.Size.Body}"
                             Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Subtle.Strong}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Border>
      <!--#endregion -->

      <!--#region 内容区：可上下滚动的 unit 列表 + 空态 -->
      <Grid Grid.Row="2">
        <ScrollViewer x:Name="UnitScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10,2,6,10"
                      PanningMode="VerticalOnly"
                      Focusable="False">
          <ItemsControl x:Name="UnitList"
                        ItemsSource="{Binding Units}"
                        ItemTemplate="{StaticResource View.Unit.Card}"
                        Focusable="False" />
        </ScrollViewer>

        <!-- 空态 -->
        <StackPanel x:Name="EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Converter.BoolToVisibility}}">
          <ctl:Icon Geometry="{StaticResource Icon.Empty}"
                    Size="32"
                    Style="{StaticResource Icon.Muted}"
                    HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Secondary}"
                     Text="这里还什么都没有"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,0" />
          <TextBlock Style="{StaticResource Text.Caption}"
                     Text="点上方的「新建文本」，或按 Ctrl+V 粘贴、把文件夹 / 图片拖进来"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Margin="0,6,0,0"
                     MaxWidth="280" />
        </StackPanel>
      </Grid>
      <!--#endregion -->

      <!--#region 底部消息条（操作反馈 + 撤销入口） -->
      <Border x:Name="StatusBar"
              Grid.Row="2"
              VerticalAlignment="Bottom"
              Background="{DynamicResource Brush.Text.Primary}"
              CornerRadius="{DynamicResource Radius.Control}"
              Margin="10,0,10,10"
              Padding="10,7"
              Opacity="0"
              Visibility="{Binding IsStatusVisible, Converter={StaticResource Converter.BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource Brush.Text.Inverse}"
                     FontSize="{DynamicResource Font.Size.Caption}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Style="{StaticResource TextButton}"
                  Content="撤销"
                  Foreground="{DynamicResource Brush.Text.Inverse}"
                  Visibility="{Binding CanUndo, Converter={StaticResource Converter.BoolToVisibility}}"
                  Margin="10,0,0,0" />
        </Grid>
      </Border>
      <!--#endregion -->
    </Grid>
  </Border>
</Window>
