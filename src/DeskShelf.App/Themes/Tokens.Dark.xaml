<!--
  深色主题设计令牌。键名与 Tokens.Light.xaml 完全一致 —— 切换主题时整本字典替换，
  界面层使用 {DynamicResource}，因此无需重启或重建视图。
  深色取值遵循「避免纯黑背景 + 保持对比度 ≥ 4.5:1」的原则。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--#region 颜色：面板与卡片 -->
  <Color x:Key="Color.Window.Background">#FF1C1F23</Color>
  <Color x:Key="Color.Surface">#FF23272E</Color>
  <Color x:Key="Color.Surface.Hover">#FF2A2F37</Color>
  <Color x:Key="Color.Surface.Pressed">#FF313741</Color>
  <Color x:Key="Color.Border">#FF343A44</Color>
  <Color x:Key="Color.Border.Strong">#FF444C58</Color>
  <Color x:Key="Color.Divider">#FF2C313A</Color>
  <!--#endregion -->

  <!--#region 颜色：文字 -->
  <Color x:Key="Color.Text.Primary">#FFE6E9ED</Color>
  <Color x:Key="Color.Text.Secondary">#FFA8B0BB</Color>
  <Color x:Key="Color.Text.Muted">#FF7C848F</Color>
  <Color x:Key="Color.Text.Inverse">#FF1C1F23</Color>
  <!--#endregion -->

  <!--#region 颜色：强调与状态 -->
  <Color x:Key="Color.Accent">#FF5B9BF8</Color>
  <Color x:Key="Color.Accent.Hover">#FF74ACF9</Color>
  <Color x:Key="Color.Accent.Pressed">#FF4587E8</Color>
  <Color x:Key="Color.Accent.Subtle">#FF232C3A</Color>
  <Color x:Key="Color.Accent.Subtle.Strong">#FF2C3A4F</Color>
  <Color x:Key="Color.Danger">#FFF0575C</Color>
  <Color x:Key="Color.Danger.Subtle">#FF3A2528</Color>
  <Color x:Key="Color.Warning">#FFD9A441</Color>
  <Color x:Key="Color.Scroll.Thumb">#FF444C58</Color>
  <Color x:Key="Color.Scroll.Thumb.Hover">#FF5A6472</Color>
  <!--#endregion -->

  <!--#region 画刷 -->
  <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
  <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
  <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
  <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle.Strong" Color="{StaticResource Color.Accent.Subtle.Strong}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="{StaticResource Color.Danger.Subtle}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{StaticResource Color.Scroll.Thumb}" />
  <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="{StaticResource Color.Scroll.Thumb.Hover}" />
  <SolidColorBrush x:Key="Brush.Icon" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Icon.Hover" Color="{StaticResource Color.Text.Primary}" />
  <!--
    输入光标与选区：跟随主文本色，从而在明暗主题下都保持足够对比度。
    若不显式设置，TextBox 会沿用系统默认的光标色（深色主题下几乎是黑色，几乎看不见）。
  -->
  <SolidColorBrush x:Key="Brush.Caret" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />
  <!-- 叠在内容（尤其是图片）之上的浮层控件底色 -->
  <SolidColorBrush x:Key="Brush.Overlay" Color="#E624282E" />
  <SolidColorBrush x:Key="Brush.Overlay.Hover" Color="#F52C313A" />
  <SolidColorBrush x:Key="Brush.Overlay.Border" Color="#4DFFFFFF" />
  <!--#endregion -->

  <!--#region 圆角（与浅色一致） -->
  <CornerRadius x:Key="Radius.Window">6</CornerRadius>
  <CornerRadius x:Key="Radius.Card">4</CornerRadius>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Button">3</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
  <!--#endregion -->

  <!--#region 间距 -->
  <Thickness x:Key="Space.Card">10,8</Thickness>
  <Thickness x:Key="Space.Card.Selected">10,8</Thickness>
  <Thickness x:Key="Space.Panel">10</Thickness>
  <Thickness x:Key="Space.Toolbar">10,0,6,0</Thickness>
  <Thickness x:Key="Space.Inline">6,0</Thickness>
  <sys:Double x:Key="Size.Gap.Card">8</sys:Double>
  <sys:Double x:Key="Size.Gap.Inline">6</sys:Double>
  <sys:Double x:Key="Size.Toolbar.Height">36</sys:Double>
  <sys:Double x:Key="Size.Button.Hit">26</sys:Double>
  <sys:Double x:Key="Size.Icon">16</sys:Double>
  <sys:Double x:Key="Size.Icon.Small">14</sys:Double>
  <!--#endregion -->

  <!--#region 字体 -->
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, Segoe UI Emoji, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>
  <sys:Double x:Key="Font.Size.Body">13</sys:Double>
  <sys:Double x:Key="Font.Size.Caption">11.5</sys:Double>
  <sys:Double x:Key="Font.Size.Title">12.5</sys:Double>
  <sys:Double x:Key="Font.LineHeight.Body">20</sys:Double>
  <!--#endregion -->

  <!--#region 动画 -->
  <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
  <Duration x:Key="Duration.Normal">0:0:0.18</Duration>
  <CubicEase x:Key="Ease.Standard" EasingMode="EaseOut" />
  <!--#endregion -->

  <!--#region 图标几何（与浅色一致，主题无关） -->
  <Geometry x:Key="Icon.Logo">M2,7 H6.5 L8,10 L10.5,3 L12,7 H14</Geometry>
  <Geometry x:Key="Icon.Copy">M4,1 H10 A1,1 0 0 1 11,2 V3 H4.5 A0.5,0.5 0 0 0 4,3.5 V11 H3 A1,1 0 0 1 2,10 V2 A1,1 0 0 1 3,1 Z M5,4 H12 A1,1 0 0 1 13,5 V13 A1,1 0 0 1 12,14 H5 A1,1 0 0 1 4,13 V5 A1,1 0 0 1 5,4 Z</Geometry>
  <Geometry x:Key="Icon.Close">M3,3 L13,13 M13,3 L3,13</Geometry>
  <Geometry x:Key="Icon.Minimize">M3,10 L13,10</Geometry>
  <Geometry x:Key="Icon.Settings">M7,5.4 A2.6,2.6 0 1 0 7,10.6 A2.6,2.6 0 0 0 7,5.4 Z M6.4,0.6 H7.6 A0.9,0.9 0 0 1 8.5,1.5 V2.7 L9.9,3.5 L10.9,2.9 A0.9,0.9 0 0 1 12.2,3.1 L12.9,3.8 A0.9,0.9 0 0 1 13.1,5.1 L12.5,6.1 L13.3,7.5 H14.5 A0.9,0.9 0 0 1 15.4,8.4 V9.6 A0.9,0.9 0 0 1 14.5,10.5 H13.3 L12.5,11.9 L13.1,12.9 A0.9,0.9 0 0 1 12.9,14.2 L12.2,14.9 A0.9,0.9 0 0 1 10.9,15.1 L9.9,14.5 L8.5,15.3 V16.5 A0.9,0.9 0 0 1 7.6,17.4 H6.4 A0.9,0.9 0 0 1 5.5,16.5 V15.3 L4.1,14.5 L3.1,15.1 A0.9,0.9 0 0 1 1.8,14.9 L1.1,14.2 A0.9,0.9 0 0 1 0.9,12.9 L1.5,11.9 L0.7,10.5 H-0.5 A0.9,0.9 0 0 1 -1.4,9.6 V8.4 A0.9,0.9 0 0 1 -0.5,7.5 H0.7 L1.5,6.1 L0.9,5.1 A0.9,0.9 0 0 1 1.1,3.8 L1.8,3.1 A0.9,0.9 0 0 1 3.1,2.9 L4.1,3.5 L5.5,2.7 V1.5 A0.9,0.9 0 0 1 6.4,0.6 Z</Geometry>
  <Geometry x:Key="Icon.Folder">M1.5,3 H6 L7.2,4.4 H14.5 A1,1 0 0 1 15.5,5.4 V12.5 A1,1 0 0 1 14.5,13.5 H1.5 A1,1 0 0 1 0.5,12.5 V4 A1,1 0 0 1 1.5,3 Z</Geometry>
  <Geometry x:Key="Icon.Image">M1.5,2.5 H14.5 A1,1 0 0 1 15.5,3.5 V12.5 A1,1 0 0 1 14.5,13.5 H1.5 A1,1 0 0 1 0.5,12.5 V3.5 A1,1 0 0 1 1.5,2.5 Z M5,5.5 A1.2,1.2 0 1 1 5,7.9 A1.2,1.2 0 0 1 5,5.5 Z M1.5,12 L5.8,7.8 L8.6,10.6 L11.4,7.4 L15,11.2</Geometry>
  <Geometry x:Key="Icon.Edit">M11.5,1.6 L14.4,4.5 L6,12.9 L2.4,13.6 L3.1,10 Z</Geometry>
  <Geometry x:Key="Icon.External">M6,2 H14 V10 M14,2 L7,9 M11,12 H2 V3</Geometry>
  <Geometry x:Key="Icon.Undo">M6,3.2 L2.4,6.6 L6,10 M2.6,6.6 H9.6 A3.6,3.6 0 0 1 9.6,13.8 H6.4</Geometry>
  <Geometry x:Key="Icon.Pin">M9.5,1.5 L14.5,6.5 L12.5,7 L9.5,10 L9.8,12.8 L8,11 L3.5,15.5 L2.5,14.5 L7,10 L5.2,8.2 L8,8.5 L11,5.5 Z</Geometry>
  <Geometry x:Key="Icon.Empty">M2,4.5 H14 V13 H2 Z M4.5,7.5 H11.5 M4.5,10.5 H9.5</Geometry>
  <Geometry x:Key="Icon.Clear">M2.6,4.6 H13.4 M6.4,2.6 H9.6 M4.2,4.6 L4.9,13.4 H11.1 L11.8,4.6 M6.8,7 V11.4 M9.2,7 V11.4</Geometry>
  <Geometry x:Key="Icon.Tray">M2,9 H5.5 L6.5,11 H9.5 L10.5,9 H14 M3,3 H13 L14,9 V13 H2 V9 Z</Geometry>
  <!-- 新建文本 unit：两条文本行 + 右下角加号（14×14 视口，说明见浅色主题同名项） -->
  <Geometry x:Key="Icon.TextAdd">M1.6,3.4 H12.4 M1.6,6.6 H12.4 M1.6,9.8 H7.4 M10.4,9.6 V13.8 M8.5,11.7 H12.3</Geometry>
  <!-- 文件 unit：带折角的文档轮廓（16×16 视口，与 Icon.Folder 风格一致） -->
  <Geometry x:Key="Icon.File">M3,1 H9.5 L13,4.5 V15 H3 Z M9.5,1 V4.5 H13</Geometry>
  <!--#endregion -->

</ResourceDictionary>
