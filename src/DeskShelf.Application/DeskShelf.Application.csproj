<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeskShelf.Application</RootNamespace>
    <AssemblyName>DeskShelf.Application</AssemblyName>
    <!-- 用例编排层：同样与 UI 无关，只依赖 Domain 抽象 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskShelf.Domain\DeskShelf.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅日志抽象：用例层不引入 DI 容器与任何 Windows API -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
