<Project>

  <!--
    全局工程约定（P0）。
    约束：Domain / Application 永不引用任何 UI 或 Windows 专有 API，
    靠「项目引用方向」+ 代码评审保证，见 Docs/Development-Plan.md §3。
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 编译告警即失败，但 IDE 风格建议（IDE****）只提示不阻断 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0005;IDE0011;IDE0040;IDE0055;IDE0090;IDE0161;IDE0300;IDE0301;IDE0305</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- 公共成员强制 XML 文档：Domain/Application 是长期资产，接口即契约 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <Company>DeskShelf</Company>
    <Product>DeskShelf</Product>
    <VersionPrefix>1.3.1</VersionPrefix>
    <Version>1.3.1</Version>
    <FileVersion>1.3.1.0</FileVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <Copyright>Copyright (c) 2026 zhaodefan</Copyright>
    <Description>DeskShelf —— Windows 桌面置物架：置顶小面板，临时存放文本 / 图片 / 文件夹</Description>
    <RepositoryUrl>https://github.com/zhaodefan/DeskShelf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/zhaodefan/DeskShelf</PackageProjectUrl>
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- 发布产物不携带 XML 文档文件（对最终用户无用，只会让包变大） -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

</Project>
