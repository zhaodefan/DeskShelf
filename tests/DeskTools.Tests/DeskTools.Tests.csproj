<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeskTools.Tests</RootNamespace>
    <AssemblyName>DeskTools.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!-- 测试工程允许 xunit 分析器与可空性提示，不阻断构建 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 测试方法不需要 XML 文档注释 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskTools.Domain\DeskTools.Domain.csproj" />
    <ProjectReference Include="..\..\src\DeskTools.Application\DeskTools.Application.csproj" />
    <ProjectReference Include="..\..\src\DeskTools.Infrastructure\DeskTools.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
